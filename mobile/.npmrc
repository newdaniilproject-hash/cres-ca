# Expo пинит react ровно (19.2.3), а expo-router тянет react-dom для веб-цели
# «на одну минорную выше». npm 7+ считает это конфликтом пиров и падает,
# хотя связка рабочая — именно поэтому `npx expo install` ставит пакеты
# с этим же флагом. Без файла каждая установка требует ручного флага,
# а забытый флаг выглядит как «у меня не ставится».
legacy-peer-deps=true
